{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capisso.ai/schemas/receipt-extraction-v1.json",
  "title": "Receipt and Invoice Extraction Result",
  "description": "Validated structured output for receipt and invoice extraction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "supplier_name",
    "document_date",
    "document_number",
    "currency",
    "subtotal_amount",
    "tax_amount",
    "total_amount",
    "document_category",
    "line_items",
    "uncertain_fields",
    "requires_human_review"
  ],
  "properties": {
    "supplier_name": {
      "type": ["string", "null"],
      "maxLength": 200
    },
    "document_date": {
      "type": ["string", "null"],
      "description": "Date in YYYY-MM-DD format.",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "document_number": {
      "type": ["string", "null"],
      "maxLength": 100
    },
    "currency": {
      "type": ["string", "null"],
      "description": "Three-letter ISO-style currency code.",
      "pattern": "^[A-Z]{3}$"
    },
    "subtotal_amount": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "tax_amount": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "total_amount": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "document_category": {
      "type": ["string", "null"],
      "enum": [
        "receipt",
        "invoice",
        "credit_note",
        "other",
        null
      ]
    },
    "line_items": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "quantity",
          "unit_price",
          "amount"
        ],
        "properties": {
          "description": {
            "type": ["string", "null"],
            "maxLength": 500
          },
          "quantity": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "unit_price": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "amount": {
            "type": ["number", "null"],
            "minimum": 0
          }
        }
      }
    },
    "uncertain_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "supplier_name",
          "document_date",
          "document_number",
          "currency",
          "subtotal_amount",
          "tax_amount",
          "total_amount",
          "document_category",
          "line_items"
        ]
      }
    },
    "requires_human_review": {
      "type": "boolean"
    }
  }
}
